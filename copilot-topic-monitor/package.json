{
  "name": "copilot-topic-monitor",
  "displayName": "Copilot Topic Monitor",
  "description": "Discuss analysis topics with GitHub Copilot and monitor streamed responses.",
  "version": "0.1.0",
  "private": true,
  "files": [
    "extension.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["AI", "Other"],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copilotTopicMonitor.open",
        "title": "Copilot Topic Monitor: Open Discussion Panel"
      }
    ]
  },
  "scripts": {
    "check": "node --check extension.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.2"
  }
}
